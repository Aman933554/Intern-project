# Database Connection (Neon PostgreSQL or Local PostgreSQL)
# Example Neon connection string: postgresql://username:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/oneatlas?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk Authentication (Clerk.com)
# Create a free project at https://dashboard.clerk.com -> API Keys -> copy Publishable & Secret key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
